# Copy to .env.local. Never commit real credentials.
# Neon Postgres integration (DATABASE_URL is also accepted and takes precedence).
STORAGE_URL=postgresql://user:password@host/database?sslmode=require
BETTER_AUTH_URL=http://127.0.0.1:4176
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google OAuth redirect: <BETTER_AUTH_URL>/api/auth/callback/google
# Private Vercel Blob store. Use different preview and production stores.
BLOB_READ_WRITE_TOKEN=
# Optional alternative S3-compatible bucket (unused when Blob is configured).
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
