{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/vercel-build.mjs",
  "outputDirectory": "dist",
  "framework": null,
  "crons": [{ "path": "/api/internal/cleanup-previews", "schedule": "0 5 * * *" }],
  "headers": [
    { "source": "/wasm/audio-analysis/audio-analysis-:hash([a-f0-9]{64}).wasm", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }, { "key": "Content-Type", "value": "application/wasm" }] },
    { "source": "/wasm/audio-analysis/audio-analysis-:hash([a-f0-9]{64}).js", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/social-cards/:file.png", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/patch-previews/:path*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/fonts/:file.woff2", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ],
  "functions": { "api/index.js": { "maxDuration": 120, "includeFiles": "{src/{index.html,patch-preview.html,industrial-theme.css,js/**,patch-previews/introduction/manifest.json},node_modules/@sparticuz/chromium/bin/**}" } },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?__path=/api/:path*" },
    { "source": "/patches/:id/images/:previewId/:variant", "destination": "/api?__path=/patches/:id/images/:previewId/:variant" },
    { "source": "/patches/:id", "destination": "/api?__path=/patches/:id" },
    { "source": "/patches", "destination": "/index.html" },
    { "source": "/docs", "destination": "/docs/index.html" },
    { "source": "/docs/:page", "destination": "/docs/:page.html" },
    { "source": "/introduction", "destination": "/introduction.html" },
    { "source": "/privacy-policy", "destination": "/privacy-policy.html" },
    { "source": "/terms-of-service", "destination": "/terms-of-service.html" }
  ],
  "redirects": [
    { "source": "/:path((?!api/internal/cleanup-previews(?:/|$)).*)", "has": [{ "type": "host", "value": "eurorack-js.vercel.app" }], "destination": "https://eurorackjs.orderandchaos.xyz/:path*", "permanent": true },
    { "source": "/patches/", "destination": "/patches", "permanent": true },
    { "source": "/privacy", "destination": "/privacy-policy", "permanent": true },
    { "source": "/terms", "destination": "/terms-of-service", "permanent": true }
  ]
}
