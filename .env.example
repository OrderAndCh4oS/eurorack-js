# Copy to .env.local. Never commit real credentials.
# Neon Postgres integration (DATABASE_URL is also accepted and takes precedence).
STORAGE_URL=postgresql://user:password@host/database?sslmode=require
BETTER_AUTH_URL=http://127.0.0.1:4176
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google OAuth redirect: <BETTER_AUTH_URL>/api/auth/callback/google
# Neon managed Better Auth URL for this branch (provided by the Vercel integration).
NEON_AUTH_BASE_URL=
# Server-only Resend sending key. RESEND_FROM can override the default verified sender.
RESEND_API_KEY=
RESEND_FROM="Eurorack JS <support@orderandchaos.xyz>"
# Private Vercel Blob store. Use different preview and production stores.
BLOB_READ_WRITE_TOKEN=
# Production daily cleanup: random server-only secret, sent by Vercel Cron.
CRON_SECRET=
# Optional alternative S3-compatible bucket (unused when Blob is configured).
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
