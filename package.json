{
  "name": "eurorack-synth",
  "version": "1.0.0",
  "type": "module",
  "description": "Eurorack synthesizer emulator",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:test-previews": "node scripts/build-test-previews.mjs",
    "build:introduction-preview": "node scripts/build-introduction-preview.mjs",
    "build:social-cards": "node scripts/build-social-cards.mjs",
    "dev": "npm run build && node --env-file-if-exists=.env.local scripts/dev-server.mjs",
    "dev:previews": "node scripts/build.mjs --instrument-only && node scripts/dev-server.mjs",
    "dev:test": "npm run build && NODE_ENV=test EURORACK_TEST_BACKEND=1 node scripts/dev-server.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local db/migrate.mjs",
    "db:cleanup": "node --env-file-if-exists=.env.local db/cleanup.mjs",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:webmcp": "playwright test --config=playwright.webmcp.config.js",
    "audit:dsp": "node scripts/dsp-audit.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@vercel/cli-config": { "zod": "4.6.6" }
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "esbuild": "0.28.2",
    "jsdom": "^25.0.0",
    "marked": "18.1.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1163.0",
    "@vercel/blob": "2.8.2",
    "better-auth": "1.7.18",
    "html-to-image": "1.11.13",
    "pg": "8.23.1",
    "sharp": "0.35.5",
    "ulid": "3.0.2"
  }
}
